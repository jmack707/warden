# secrets & generated material — never commit
.env
certs/**/*.key
certs/**/*.csr
certs/**/*.srl
certs/**/*.ext
certs/**/*.p12
certs/san.cnf
# generated by the openldap container on first start; a DH group shared by every
# clone of a public repo is worse than one generated locally
certs/dhparam.pem
clients/*.key
clients/*.csr
clients/*.ext
clients/*.p12
# regenerated on every deploy — tracking them makes 'git pull' conflict on deploy hosts
clients/*.crt
certs/ca.crt
certs/ldap.crt
*.log
initdb.sql
openbao/.openbao-keys.json

# rendered from openbao/*.ldif.tmpl by scripts/configure-openbao.sh
openbao/creation.ldif
openbao/deletion.ldif
openbao/rollback.ldif
