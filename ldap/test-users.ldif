# Three test principals for the cert -> group -> access matrix (fixtures).
# Human identities live in ou=people (kept separate from the ephemeral OpenBao
# accounts in ou=users). "BIG-IP Admin" = groupOfNames cn=bigip-admins,ou=groups.
#
#   alice.admin    valid cert   + member of bigip-admins   -> expect ADMIN
#   bob.user       valid cert   + NOT a member             -> expect DENIED / no admin
#   carol.expired  EXPIRED cert + member of bigip-admins   -> expect FAIL at cert check
#                  (carol is intentionally IN the group, so the ONLY thing that stops
#                   her is the expired certificate — isolates the cert-validation step)
#
# Apply after the memberof overlay:
#   envsubst < ldap/test-users.ldif | ldapadd -x -H ldap://$WARDEN_HOST_IP -D cn=admin,$BASE_DN -w $LDAP_ADMIN_PW
dn: ${WARDEN_USER_SEARCH_BASE}
objectClass: organizationalUnit
ou: people

dn: ou=groups,${BASE_DN}
objectClass: organizationalUnit
ou: groups

dn: uid=alice.admin,${WARDEN_USER_SEARCH_BASE}
objectClass: inetOrgPerson
uid: alice.admin
cn: alice.admin
sn: Admin
givenName: Alice
mail: alice.admin@warden.lab
userPassword: ${TEST_USER_PW}

dn: uid=bob.user,${WARDEN_USER_SEARCH_BASE}
objectClass: inetOrgPerson
uid: bob.user
cn: bob.user
sn: User
givenName: Bob
mail: bob.user@warden.lab
userPassword: ${TEST_USER_PW}

dn: uid=carol.expired,${WARDEN_USER_SEARCH_BASE}
objectClass: inetOrgPerson
uid: carol.expired
cn: carol.expired
sn: Expired
givenName: Carol
mail: carol.expired@warden.lab
userPassword: ${TEST_USER_PW}
