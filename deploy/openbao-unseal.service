[Unit]
Description=Auto-unseal Warden OpenBao after boot (raft-persisted; operator chose AUTO custody)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# give docker + the openbao container (restart=unless-stopped) time to come up
ExecStartPre=/bin/sleep 15
ExecStart=/root/warden/scripts/openbao-init-unseal.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
