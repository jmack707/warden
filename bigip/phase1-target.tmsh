#-----------------------------------------------------------------------------
# T1.7 — Phase 1 target BIG-IP (bigipa.dakota, mgmt 10.2.1.5) auth configuration.
# Human-pasteable tmsh. The REST script bigip/phase1-target-rest.sh mirrors this 1:1.
#
# SAFETY (hard requirements — read before pasting):
#   * Have a console or second local-admin session OPEN before `modify auth source`.
#     On Dakota: `ssh root@192.168.99.6 'qm terminal 210'`  (or the PVE web console).
#   * `admin` and `root` ALWAYS remain local on TMOS — flipping auth source to ldap
#     does NOT lock them out; only *remote* logins depend on LDAPS working.
#   * Never modify admin/root.
#   * Substitute <BIND_PW> below with the value from .env (BIND_PW). Do not commit it.
#-----------------------------------------------------------------------------

# 0. Human: copy certs/ca.crt to /var/tmp/ca.crt on bigipa (scp or REST upload), then:
create sys file ssl-cert pua-lab-ca.crt { source-path file:/var/tmp/ca.crt }

create auth ldap system-auth {
    servers { 10.2.20.30 }
    port 636
    ssl enabled
    ssl-ca-cert-file pua-lab-ca.crt
    bind-dn "cn=bigip-bind,ou=svc,dc=pua,dc=lab"
    bind-pw "<BIND_PW>"
    search-base-dn "ou=users,dc=pua,dc=lab"
    login-attribute uid
}

modify auth remote-user { default-role no-access remote-console-access disabled }

modify auth remote-role role-info add {
    pua_admins {
        attribute "employeeType=pua-admins"
        role administrator
        user-partition All
        console tmsh
        line-order 1
    }
}

# ---- point of no easy return for REMOTE auth; local admin/root unaffected ----
modify auth source { type ldap }
save sys config

# Rollback (from the open admin session):
#   modify auth source { type local }
#   save sys config
