# APM iRule Event handler for the OpenBao credential fetch (static credential model).
# The per-session policy fires an 'iRule Event' agent with id `openbao_fetch`; this
# rotates the CN's privileged password, reads it back, and stashes it in a session
# variable for the form-SSO agent to inject. ${WARDEN_HOST_IP} is rendered at upload
# time by apm-build.sh; the scoped token comes from the warden_openbao_dg data group.
#
# PoC-grade: plaintext sideband to OpenBao with regex JSON extraction. For production,
# move to iRulesLX (real JSON parsing), enable TLS on OpenBao with a pinned CA, and hold
# the token in an APM system variable rather than a data group.
#-----------------------------------------------------------------------------
when ACCESS_POLICY_AGENT_EVENT {
    if { [ACCESS::policy agent_id] eq "openbao_fetch" } {
        set cn [ACCESS::session data get session.custom.cn]
        set tok [class lookup token warden_openbao_dg]
        if { $cn eq "" } { return }
        if { $tok eq "" } { return }

        set c [connect -timeout 3000 -idle 5 ${WARDEN_HOST_IP}:8200]
        if { $c ne "" } {
            set r "POST /v1/ldap/rotate-role/$cn HTTP/1.1\r\nHost: ${WARDEN_HOST_IP}\r\nX-Vault-Token: $tok\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
            send -timeout 3000 $c $r
            recv -timeout 3000 $c
            close $c
        }

        set c2 [connect -timeout 3000 -idle 5 ${WARDEN_HOST_IP}:8200]
        if { $c2 eq "" } {
            ACCESS::session data set session.custom.warden.fetch_err "connect-failed"
            return
        }
        set g "GET /v1/ldap/static-cred/$cn HTTP/1.1\r\nHost: ${WARDEN_HOST_IP}\r\nX-Vault-Token: $tok\r\nConnection: close\r\n\r\n"
        send -timeout 3000 $c2 $g
        set resp ""
        for { set i 0 } { $i < 16 } { incr i } {
            set chunk [recv -timeout 2000 $c2]
            if { $chunk eq "" } { break }
            append resp $chunk
        }
        close $c2

        if { [regexp {"password":"([^"]+)"} $resp all pw] } {
            ACCESS::session data set session.custom.warden.password $pw
        } else {
            ACCESS::session data set session.custom.warden.fetch_err "parse-failed"
        }
    }
}
