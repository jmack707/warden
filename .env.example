# Copy to .env (gitignored) and fill in. Values below are the Dakota-lab defaults.
LAB_HOST_IP=10.2.20.30          # the Docker host running this stack (pua-oss VM, VLAN 73)
BIGIP_MGMT=10.2.1.5             # target = bigipa.dakota management address
BIGIP_USER=admin               # for [AGENT-IF-ACCESS] tasks only
BIGIP_PASS=                     # never commit — sourced from lab OpenBao kv/bigip/common
BASE_DN=dc=pua,dc=lab
LDAP_ADMIN_PW=AdminPw1!         # lab only — rotate for anything shared
BIND_PW=BindPw1!                # BIG-IP read-only bind account (cn=bigip-bind)
BAO_ADDR=http://10.2.20.30:8200
BAO_TOKEN=root                  # dev mode only
TEST_USER_PW=TestUser1!         # password for the alice/bob/carol test principals (lab only)

# Credential model for the operator/issue path (see ADR 0006):
#   ephemeral = mint a throwaway leased account (random username, auto-deleted at TTL)
#   static    = rotate a standing account's password (username = the principal/CN)
PUA_CRED_MODE=ephemeral
PUA_EPHEMERAL_ROLE=pua-admin    # OpenBao ldap/creds/<role> used in ephemeral mode
