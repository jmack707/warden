# Warden demo configuration. Copy to .env (gitignored) and fill in the <angle-bracket>
# values. The REQUIRED blocks are all a customer must set; the rest have working defaults.
# Full reference: docs/reference/configuration.md.

# ─── REQUIRED: this host ────────────────────────────────────────────────────
# IP of the Docker host running this stack, as the BIG-IP reaches it (LDAPS + OpenBao).
# The generated LDAPS server-cert SAN is built from this, so it must match.
WARDEN_HOST_IP=<this-host-ip>

# ─── REQUIRED: directory ────────────────────────────────────────────────────
# bundled  = Warden runs its own OpenLDAP in Docker and seeds it (default; zero setup).
# external = bring your own AD / FreeIPA / LDAP. Warden creates NOTHING in it — see the
#            block below and docs/directory.md.
WARDEN_DIRECTORY_MODE=bundled
WARDEN_DOMAIN=warden.lab            # LDAP domain (bundled: drives the container + cert SAN)
BASE_DN=dc=warden,dc=lab            # must correspond to WARDEN_DOMAIN
LDAP_ADMIN_PW=<change-me>           # bundled only: OpenLDAP cn=admin password
BIND_PW=<change-me>                 # read-only bind password the BIG-IP searches with

# ─── the BIG-IP admin group ─────────────────────────────────────────────────
# Members of this group get Administrator on the target BIG-IP; every other identity that
# authenticates lands on the default role (guest = read-only).
WARDEN_ADMIN_GROUP_DN=              # the admin group's DN; default cn=bigip-admins,ou=groups,${BASE_DN}
# The test the BIG-IP applies to decide "is this user an administrator", written as
# <attribute>=<value>. It is evaluated against the PRIVILEGED account the BIG-IP just
# authenticated — not the human identity entry — so that account is what must carry the
# attribute (or be a member of the group). Leave empty to take the default for your mode:
#   bundled  -> employeeType=warden-admins          (the stamp Warden seeds)
#   external -> memberOf=${WARDEN_ADMIN_GROUP_DN}   (real group membership)
# CAUTION: the BIG-IP only sees attributes a DEFAULT LDAP search returns; it never asks for
# them by name. An attribute the directory returns only on request — notably memberOf from
# OpenLDAP's memberof overlay, which is operational — is invisible to it, and the failure is
# silent: everyone authenticates fine and lands read-only. Active Directory stores memberOf
# normally and is fine. Verify before deploying with scripts/preflight-directory.sh, which
# checks exactly this; background in docs/directory.md.
WARDEN_ADMIN_ROLE_ATTRIBUTE=        # e.g. memberOf=cn=BigipAdmins,ou=Groups,dc=example,dc=com

# ─── EXTERNAL directory only (ignored when WARDEN_DIRECTORY_MODE=bundled) ────
# Validate all of this before touching the BIG-IP:  scripts/preflight-directory.sh
WARDEN_LDAP_HOST=                   # AD DC / LDAP server address (LDAPS)
WARDEN_LDAP_PORT=389                # plain LDAP (APM AAA query)
WARDEN_LDAPS_PORT=636               # LDAPS (BIG-IP system-auth, OpenBao)
WARDEN_LDAP_SCHEMA=openldap         # openldap | ad  (ad resets unicodePwd, logs in as sAMAccountName)
WARDEN_LDAP_CA_FILE=                # PEM of the CA that issued your LDAPS cert
WARDEN_BIND_DN=                     # read-only search bind (default cn=bigip-bind,ou=svc,${BASE_DN})
WARDEN_USER_SEARCH_BASE=            # identity subtree, read-only (default ou=people,${BASE_DN})
WARDEN_PRIV_SEARCH_BASE=            # privileged accounts OpenBao ROTATES (default ou=users,${BASE_DN})
WARDEN_DIR_ADMIN_DN=                # account that may reset passwords under the privileged subtree
WARDEN_DIR_ADMIN_PW=                # its password. OpenBao uses this bind to reset those passwords
WARDEN_LOGIN_ATTR=                  # default uid, or sAMAccountName when schema=ad
WARDEN_PRINCIPALS=                  # CNs to issue client certs + static roles for, space-separated

# ─── REQUIRED: target BIG-IP (A) ────────────────────────────────────────────
BIGIP_MGMT=<bigip-a-mgmt-ip>        # BIG-IP A management address (REST)
BIGIP_USER=admin                    # BIG-IP account the deploy/teardown REST calls authenticate as
BIGIP_PASS=<bigip-admin-pw>         # demo: plaintext here. PRODUCTION: use a secret manager,
                                    # not .env. Wrappers preserve an injected value if set.

# ─── OPTIONAL: HA peer (B) — leave empty for a single standalone BIG-IP ──────
WARDEN_BIGIP_B_MGMT=                # BIG-IP B management address (setting it enables the HA path)
WARDEN_BIGIP_B_TMUI=                # BIG-IP B internal self-IP that APM proxies to for its TMUI

# ─── APM data-plane ─────────────────────────────────────────────────────────
WARDEN_APM_VIP=<apm-vip-ip>         # the front-door VIP customers browse to (https://<vip>/)
WARDEN_SHADOW_A=192.0.2.5           # RFC5737 TEST-NET façade for A's TMUI (non-routable; keep as-is)
WARDEN_SHADOW_B=192.0.2.6           # façade for B's TMUI (used only when the HA peer is set)

# ─── OpenBao ────────────────────────────────────────────────────────────────
BAO_ADDR=http://<this-host-ip>:8200 # OpenBao API address, as this host and the BIG-IP reach it
BAO_TOKEN=root                      # dev mode; production value is written by openbao-init-unseal.sh

# ─── credential model (see ADR 0006) ────────────────────────────────────────
WARDEN_CRED_MODE=static             # static = inject a rotated password (never seen); ephemeral = throwaway leased account
WARDEN_EPHEMERAL_ROLE=warden-admin  # OpenBao ldap/creds/<role> used in ephemeral mode

# ─── test principals + client certs ─────────────────────────────────────────
TEST_USER_PW=<change-me>            # bundled only: password for the demo principals (alice/bob/carol)
WARDEN_P12_PASS=warden              # export password for the browser client-cert bundles (.p12)
